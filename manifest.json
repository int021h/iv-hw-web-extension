{
  "manifest_version": 3,
  "name": "Warden — перехватчик RPC для аналитики HW Alliance",
  "description": "Перехватывает игровые RPC-вызовы и пересылает их в Warden для аналитики HW Alliance. Неофициальное расширение.",
  "version": "1.0.1",
  "icons": {
    "16": "icons/icon-16.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "action": {
    "default_popup": "src/popup/popup.html",
    "default_title": "Warden",
    "default_icon": {
      "16": "icons/icon-16.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    }
  },
  "background": {
    "service_worker": "src/background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://*.hero-wars-alliance.com/*"
      ],
      "js": ["src/content.js"],
      "run_at": "document_start",
      "all_frames": true
    },
    {
      "matches": [
        "https://warden.pankov.dev/*",
        "http://localhost:3000/*"
      ],
      "js": ["src/marker.js"],
      "run_at": "document_start"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["src/inject.js"],
      "matches": ["https://*.hero-wars-alliance.com/*"]
    }
  ],
  "host_permissions": [
    "https://*.hero-wars-alliance.com/*",
    "https://*.pankov.dev/*",
    "http://localhost/*"
  ],
  "permissions": ["storage", "cookies"]
}